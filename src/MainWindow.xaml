<Window
    x:Class="RefractionLab.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="Desktop Refraction Lab">
  <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark">
    <canvas:CanvasControl
        x:Name="GlassCanvas"
        ClearColor="#00000000"
        IsHitTestVisible="False"
        Draw="OnGlassDraw" />

    <!-- Nex acrylic tokens: panel-surface rgba(17,20,27,.12), panel-edge rgba(255,255,255,.2), radius 8px -->
    <Border
        x:Name="GlassTint"
        Background="#1F11141B"
        BorderBrush="#33FFFFFF"
        BorderThickness="1"
        CornerRadius="8"
        IsHitTestVisible="False" />

    <Grid x:Name="Controls" Padding="18,10,18,10">
      <Grid.Resources>
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
      </Grid.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="26" />
        <RowDefinition Height="56" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock Text="DESKTOP REFRACTION LAB  ·  RESEARCH PROTOTYPE" FontSize="10" CharacterSpacing="80" Foreground="#FF8E95A1" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="7">
          <Ellipse x:Name="CaptureDot" Width="8" Height="8" Fill="#FF68717F" />
          <TextBlock x:Name="CaptureBadge" Text="CAPTURE OFF" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="#FF9BA3B0" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="⌕" FontSize="24" FontWeight="Light" Foreground="#FFAEB6C2" VerticalAlignment="Center" />
        <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search apps, files, and settings" FontSize="18" FontWeight="Light" BorderThickness="0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="ESC  CLOSE" FontSize="9" CharacterSpacing="55" Foreground="#FF818894" VerticalAlignment="Center" />
      </Grid>

      <StackPanel Grid.Row="2" Spacing="2" Margin="0,4,0,0">
        <Border Padding="10,7" CornerRadius="8" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="26" Height="26" CornerRadius="8" Background="#FF22B8C9" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Design notes" FontSize="13" Foreground="#FFF4F4F6" /><TextBlock Text="Recent document" FontSize="10" Foreground="#FFAEB6C2" /></StackPanel>
            <TextBlock Grid.Column="2" Text="↵" FontSize="12" Foreground="#FFAEB6C2" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Padding="10,7" CornerRadius="8">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="26" Height="26" CornerRadius="8" Background="#FF8D75D8" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Color picker" FontSize="13" Foreground="#FFF4F4F6" /><TextBlock Text="Utility" FontSize="10" Foreground="#FFAEB6C2" /></StackPanel>
          </Grid>
        </Border>
        <Border Padding="10,7" CornerRadius="8">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="26" Height="26" CornerRadius="8" Background="#FFDB805F" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="System settings" FontSize="13" Foreground="#FFF4F4F6" /><TextBlock Text="Control panel" FontSize="10" Foreground="#FFAEB6C2" /></StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="3" Spacing="6" Margin="0,6,0,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="AcrylicButton" Content="A  Acrylic only" Click="OnAcrylicClick" />
          <Button x:Name="RefractionButton" Content="B  Refraction · Windows capture" Click="OnRefractionClick"
                  ToolTipService.ToolTip="Windows Graphics Capture: you pick the display, and Windows draws a yellow border while it runs." />
          <Button x:Name="DuplicationButton" Content="C  Refraction · no border" Click="OnDuplicationClick"
                  ToolTipService.ToolTip="DXGI Desktop Duplication: no Windows border or picker. Only this panel's badge shows that capture is active." />
          <Button x:Name="StopButton" Content="Stop capture" Click="OnStopClick" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Bend" FontSize="11" Foreground="#FF9BA3B0" VerticalAlignment="Center" />
          <Slider x:Name="BendSlider" Width="130" Minimum="0" Maximum="100" Value="50" IsEnabled="False" VerticalAlignment="Center" ValueChanged="OnBendChanged" />
          <TextBlock Text="Max FPS" FontSize="11" Foreground="#FF9BA3B0" VerticalAlignment="Center" Margin="16,0,0,0" />
          <ComboBox x:Name="FpsBox" Width="104" SelectedIndex="2" SelectionChanged="OnFpsChanged">
            <ComboBoxItem Content="15" Tag="15" />
            <ComboBoxItem Content="30" Tag="30" />
            <ComboBoxItem Content="60" Tag="60" />
            <ComboBoxItem Content="Unlimited" Tag="0" />
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <CheckBox x:Name="BorderlessBox" Content="Ask Windows to hide border (B)" MinWidth="0" FontSize="11"
                    ToolTipService.ToolTip="Mode B only. Windows shows its own consent prompt and decides; if it refuses, the border stays." />
          <CheckBox x:Name="LogBox" Content="Log stats to file" MinWidth="0" FontSize="11"
                    ToolTipService.ToolTip="Off by default. While capture runs, writes one CSV row per second of the numbers shown here (no screen content) to %LOCALAPPDATA%\RefractionLab\logs." />
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="4" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="0,8,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" Text="Acrylic baseline  ·  desktop capture is off" FontSize="10" Foreground="#FFAEB6C2" TextWrapping="Wrap" MaxLines="3" IsTextSelectionEnabled="True" />
        <TextBlock x:Name="MetricsText" Grid.Row="1" FontSize="9" Foreground="#FF8E95A1" Margin="0,3,0,0" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
      </Grid>
    </Grid>
  </Grid>
</Window>
